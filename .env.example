# VCA production environment template
# Never commit real credentials.

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_URL=http://localhost:4000
PUBLIC_VERIFY_URL=http://localhost:3000
DATABASE_URL=postgresql://vca:vca_dev_password@localhost:5432/vca?schema=public
AUTH_SECRET=replace-with-long-random-secret

# S3-compatible object storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=vca
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# External integrations - configure only when actually connected
GEMINI_API_KEY=
MARKET_DATA_PROVIDER=
MARKET_DATA_API_KEY=
PAYMENT_PROVIDER=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

LOG_LEVEL=info
