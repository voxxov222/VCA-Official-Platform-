    "canvas-confetti": "^1.9.4",
    "d3": "^7.9.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "recharts": "^3.10.1",
    "three": "^0.185.1",
    "vite": "^6.2.3"
